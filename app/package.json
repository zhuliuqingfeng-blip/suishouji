{
  "name": "suishouji",
  "version": "1.1.0",
  "private": true,
  "description": "完全保存在本地的个人图文随手记",
  "author": "Local Notes",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "setup": "node node_modules/electron/install.js && node scripts/icon.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/ui-test.mjs",
    "package": "npm run build && electron-builder --win dir --x64",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "local.suishouji.desktop",
    "productName": "随手记",
    "directories": {
      "output": "../.artifacts/staging"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "artifactName": "随手记-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.58.0",
    "playwright": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
